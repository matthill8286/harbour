# Copy to apps/api/.env for local development.
DATABASE_URL=postgresql://vip:vip@localhost:5432/vehicle_import?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=3001
WEB_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
ANPR_PROVIDER=mock
VEHICLE_DATA_PROVIDER=mock
# Vehicle lookup / ANPR — see apps/api/.env.example (dvla, platerecognizer)
# DVLA_API_KEY=
# PLATE_RECOGNIZER_API_KEY=
# Teltonika TAT140 via Flespi — see apps/api/.env.example
# FLESPI_WEBHOOK_SECRET=
# FLESPI_TOKEN=
# Days GPS history is kept (default 90)
# GPS_RETENTION_DAYS=90
# Email — see apps/api/.env.example (EMAIL_PROVIDER=log|brevo|resend)
# EMAIL_PROVIDER=log
# EMAIL_FROM=Harbour <onboarding@resend.dev>
# RESEND_API_KEY=
# Harbour AI — see apps/api/.env.example (AI_PROVIDER=log|openai)
# AI_PROVIDER=log
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
