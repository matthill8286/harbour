# Serves the built web app inside its container. The public edge proxies to it.
:80 {
	root * /srv
	encode zstd gzip

	# Vite puts a content hash in every file name under /assets, so those never change.
	# Only a file that exists is marked so. A browser must never keep a miss for a year.
	@assets {
		path /assets/*
		file
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else, index.html above all, is checked with the server on every load,
	# so a release reaches open browsers on their next page load instead of whenever a cache expires.
	@page not path /assets/*
	header @page Cache-Control "no-cache"

	# After a release, a tab opened before it asks for files that have gone. It gets a 404,
	# not the app's HTML, and the app then reloads itself.
	handle /assets/* {
		file_server
	}

	# Every other address is a page of the app.
	handle {
		try_files {path} /index.html
		file_server
	}
}
