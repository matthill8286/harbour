generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A database that still has the retired OWNER and VIEWER values needs
/// prisma/pre-push/remove-retired-roles.sql before `db push`.
enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum SubscriptionPlan {
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum UsageMetric {
  IMPORT_JOBS
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum CostCategory {
  TRANSPORT
  REGISTRATION
  IMPORT
  DOCUMENTATION
  REPAIRS
  STORAGE
  ADMINISTRATIVE
  OTHER
}

enum ChargeCategory {
  TRANSPORT
  IMPORT_SERVICE
  REGISTRATION_SERVICE
  OTHER
}

enum PhotoCategory {
  BEFORE_COLLECTION
  COLLECTION
  DAMAGE
  MILEAGE
  VIN
  REGISTRATION
  ARRIVAL
  FINAL
  OTHER
}

enum DocumentType {
  V5C
  PURCHASE_INVOICE
  TRANSPORT
  IMPORT
  REGISTRATION
  CUSTOMS
  CUSTOMER
  INSPECTION
  OTHER
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER
}

enum JourneyType {
  ROAD
  FERRY
  OTHER
}

enum JourneyStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TrackerStatus {
  AVAILABLE
  ASSIGNED
  OFFLINE
  RETIRED
}

enum RegistrationKind {
  UK
  TEMPORARY
  CYPRUS
  OTHER
}

model Organisation {
  id        String             @id @default(cuid())
  name      String
  legalName String?
  slug      String             @unique
  logo      String?
  timezone  String             @default("Europe/Nicosia")
  country   String             @default("CY")
  currency  String             @default("EUR")
  status    OrganisationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships      OrganisationMembership[]
  settings         OrganisationSettings?
  subscription     Subscription?
  usageRecords     UsageRecord[]
  features         OrganisationFeature[]
  supportAccess    SupportAccessGrant[]
  customers        Customer[]
  vehicles         Vehicle[]
  importJobs       ImportJob[]
  routeTemplates   RouteTemplate[]
  routes             Route[]
  trackers         Tracker[]
  trackerAssignments TrackerAssignment[]
  workflowStatuses WorkflowStatus[]
  locationEvents   LocationEvent[]
  journeys         Journey[]
  documents        Document[]
  photos           Photo[]
  tasks            Task[]
  costs            Cost[]
  charges          CustomerCharge[]
  notes            Note[]
  auditLogs        AuditLog[]
  portalInvites    PortalInvite[]
  staffInvites     StaffInvite[]
  statusHistory    JobStatusHistory[]
  registrations    VehicleRegistration[]
  suspensions      WorkspaceSuspension[]
  erasures         CustomerErasure[]
  termsAcceptances TermsAcceptance[]
}

model OrganisationSettings {
  organisationId          String       @id
  organisation            Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brandName               String?
  primaryContact          String?
  notificationSettings    Json?
  customerPortalSettings  Json?
  /// How long GPS points are kept, in days. Null uses GPS_RETENTION_DAYS.
  gpsRetentionDays        Int?
  /// The workspace's own secret for posting positions from its own Flespi
  /// account. Only its SHA-256 hash is stored. Null means it has none.
  gpsWebhookSecretHash    String?
  gpsWebhookSecretSetAt   DateTime?
  updatedAt               DateTime     @updatedAt
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole
  status         MembershipStatus @default(ACTIVE)
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// When the person themselves accepted this membership. Only an accepted
  /// membership can be made ACTIVE by someone else.
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, role])
  @@index([customerId])
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// One suspension of a workspace by a platform operator, kept after it ends.
/// The operator is stored by id only, so the record outlives their account.
model WorkspaceSuspension {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reason           String
  suspendedById    String
  suspendedAt      DateTime     @default(now())
  restoreReason    String?
  restoredById     String?
  restoredAt       DateTime?

  @@index([organisationId, restoredAt])
}

/// What was done with the platform operator role: grants, revocations,
/// suspensions and restores. It belongs to no workspace.
model PlatformAuditLog {
  id         String   @id @default(cuid())
  action     String
  /// The operator who did it. Empty for a grant or revocation run on the server.
  operatorId String?
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Subscription {
  id             String             @id @default(cuid())
  organisationId String             @unique
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan   @default(STARTER)
  status         SubscriptionStatus @default(TRIAL)
  monthlyPrice   Decimal?           @db.Decimal(12, 2)
  billingCycle   BillingCycle       @default(MONTHLY)
  startedAt      DateTime           @default(now())
  renewalAt      DateTime?
  /// The end of the notice period of a lapsed plan. From then the workspace can
  /// be read and exported, but not changed. Empty means no restriction.
  readOnlyFrom   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model UsageRecord {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  metric         UsageMetric
  periodStart    DateTime
  quantity       Int          @default(0)

  @@unique([organisationId, metric, periodStart])
  @@index([organisationId, metric])
}

model OrganisationFeature {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  flag           String
  enabled        Boolean      @default(false)

  @@unique([organisationId, flag])
}

model SupportAccessGrant {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  grantedToUserId String
  grantedTo       User         @relation(fields: [grantedToUserId], references: [id], onDelete: Cascade)
  reason          String
  startsAt        DateTime     @default(now())
  endsAt          DateTime
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([organisationId, endsAt])
  @@index([grantedToUserId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  /// True once the user has confirmed an authenticator code. Staff must turn this on.
  twoFactorEnabled Boolean @default(false)
  /// Sessions issued before this time stop working, so a password reset signs out other devices.
  passwordChangedAt DateTime?
  /// Sessions issued before this time stop working. Set when two-factor is turned on.
  sessionsRevokedAt DateTime?
  /// Wrong passwords on the two-factor settings, and the lock they lead to.
  passwordCheckFailedCount Int       @default(0)
  passwordCheckLockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  twoFactor            TwoFactor?
  passwordResets       PasswordReset[]
  memberships          OrganisationMembership[]
  platformAdmin        PlatformAdmin?
  supportAccessGrants  SupportAccessGrant[]
  assignedTasks        Task[]              @relation("TaskAssignee")
  notes                Note[]
  documents            Document[]
  photos               Photo[]
  statusChanges        JobStatusHistory[]
  auditLogs            AuditLog[]
  portalInvites        PortalInvite[]
  createdPortalInvites PortalInvite[]      @relation("PortalInviteCreator")
  staffInvites         StaffInvite[]
  createdStaffInvites  StaffInvite[]       @relation("StaffInviteCreator")
  termsAcceptances     TermsAcceptance[]
}

/// Authenticator (TOTP) secret and backup codes for one user. Both are stored encrypted.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM ciphertext of the base32 TOTP secret.
  secret                  String
  /// AES-256-GCM ciphertext of the JSON array of unused backup codes.
  backupCodes             String
  /// False until the user proves the authenticator works by entering a code.
  verified                Boolean   @default(false)
  /// The time step of the last authenticator code accepted, so a code works once.
  lastUsedStep            Int?
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

/// A one-time link that lets a user choose a new password. Only a hash of the token is kept.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// A sign-up waiting for its email to be proven. No account or workspace exists
/// until the link sent to that address is used. Only a hash of the token is kept.
model SignupRequest {
  id               String    @id @default(cuid())
  email            String
  organisationName String
  name             String
  tokenHash        String    @unique
  /// The licence the workspace is being set up under, where licences are checked.
  licenceId        String?
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Customer {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  address        String?
  notes          String?
  /// Set when the customer's personal data was erased. The row stays, empty,
  /// for the jobs that may have to be kept.
  erasedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships   OrganisationMembership[]
  importJobs    ImportJob[]
  jobNotes      Note[]
  portalInvites PortalInvite[]

  @@index([organisationId])
  @@index([organisationId, email])
}

/// Permanent identity of the physical vehicle. Registrations can change.
model Vehicle {
  id                     String       @id @default(cuid())
  organisationId         String
  organisation           Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  vin                    String?
  make                   String?
  model                  String?
  variant                String?
  year                   Int?
  mileage                Int?
  fuelType               String?
  colour                 String?
  engineSize             String?
  bodyType               String?
  countryOfRegistration  String?
  ukRegistration         String?
  temporaryRegistration  String?
  cyprusRegistration     String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  importJobs         ImportJob[]
  registrations      VehicleRegistration[]
  trackerAssignments TrackerAssignment[]
  locationEvents     LocationEvent[]
  notes              Note[]

  @@index([organisationId])
  @@index([vin])
  @@index([ukRegistration])
  @@index([cyprusRegistration])
}

model VehicleRegistration {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind           RegistrationKind
  number         String
  country        String?
  issuedAt       DateTime         @default(now())
  endedAt        DateTime?

  @@index([vehicleId])
  @@index([organisationId])
}

/// A workspace's route, such as UK → Cyprus, with its own stages and statuses.
model Route {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name               String
  /// Short form for narrow columns, such as "GB → CY".
  shortLabel         String
  originCountry      String
  destinationCountry String
  /// New jobs use this route unless someone picks another. One per workspace.
  isDefault          Boolean      @default(false)
  /// Off while it is a draft, so New job does not offer it.
  active             Boolean      @default(false)
  /// Set only on the seeded UK → Cyprus route, whose statuses drive the GPS corridor.
  systemKey          String?
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  stages   RouteStage[]
  statuses RouteStatus[]
  jobs     ImportJob[]

  @@index([organisationId, sortOrder])
}

model RouteStage {
  id              String  @id @default(cuid())
  routeId         String
  route           Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name            String
  /// What the customer portal calls this stage.
  customerName    String
  /// Off: the customer sees it as part of the next visible stage.
  customerVisible Boolean @default(true)
  sortOrder       Int

  statuses RouteStatus[]

  @@index([routeId, sortOrder])
}

model RouteStatus {
  id        String     @id @default(cuid())
  routeId   String
  route     Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stageId   String
  stage     RouteStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  /// Stored on jobs as their status. Stays the same when the label is renamed.
  code      String
  label     String
  sortOrder Int

  @@unique([routeId, code])
  @@index([stageId, sortOrder])
}

model WorkflowStatus {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String
  label          String
  sortOrder      Int
  isTerminal     Boolean      @default(false)

  @@unique([organisationId, code])
}

model ImportJob {
  id                   String       @id @default(cuid())
  organisationId       String
  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId            String
  vehicle              Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  reference            String
  status               String       @default("NEW")
  /// The route this job follows. Null only until startup assigns the workspace's default route.
  routeId              String?
  route                Route?         @relation(fields: [routeId], references: [id], onDelete: Restrict)
  originCountry        String       @default("GB")
  destinationCountry   String       @default("CY")
  registrationCountry  String?
  expectedDeliveryDate DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  routeTemplateId      String?
  routeTemplate        RouteTemplate? @relation(fields: [routeTemplateId], references: [id], onDelete: SetNull)

  statusHistory      JobStatusHistory[]
  journeys           Journey[]
  documents          Document[]
  photos             Photo[]
  tasks              Task[]
  costs              Cost[]
  charges            CustomerCharge[]
  notes              Note[]
  trackerAssignments TrackerAssignment[]
  locationEvents     LocationEvent[]

  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([organisationId, createdAt])
  @@index([organisationId, customerId])
  @@index([organisationId, vehicleId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([routeTemplateId])
  @@index([routeId, status])
}

/// Curated UK→BG→GR corridors staff assign on a job. Platform templates have null organisationId.
model RouteTemplate {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  /// Ordered GeoPoint[] — { label, latitude, longitude }
  waypoints      Json
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  jobs ImportJob[]

  @@unique([code])
  @@index([organisationId, active, sortOrder])
}

model JobStatusHistory {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId    String
  importJob      ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  fromStatus     String?
  toStatus       String
  changedById    String?
  changedBy      User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime     @default(now())

  @@index([importJobId, createdAt])
  @@index([organisationId])
}

model Journey {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId    String
  importJob      ImportJob     @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  type           JourneyType   @default(ROAD)
  origin         String
  destination    String
  status         JourneyStatus @default(PLANNED)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([importJobId])
  @@index([organisationId])
}

model Tracker {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  serialNumber   String
  provider       String        @default("flespi")
  status         TrackerStatus @default(AVAILABLE)
  batteryLevel   Int?
  lastSeenAt     DateTime?
  /// Set only by the platform operator once the workspace has shown it holds
  /// this real unit. No gateway position reaches the tracker until then.
  ownershipConfirmedAt DateTime?
  /// Set while this claim on a real IMEI is disputed. It receives nothing.
  imeiConflictAt       DateTime?
  /// How the unit is powered. A battery unit is the recommended kind.
  powerSource           TrackerPowerSource @default(BATTERY)
  /// How often the unit is set to report. Missing two reports counts as no signal.
  reportIntervalMinutes Int                @default(60)
  /// The vehicle's supply voltage, from a hard-wired or diagnostic-port unit.
  supplyVoltage         Float?
  /// Who fitted a hard-wired or diagnostic-port unit, and when.
  fittedBy              String?
  fittedAt              DateTime?
  /// That the vehicle owner's written permission to fit the unit is held.
  ownerPermissionHeld   Boolean            @default(false)
  /// Who confirmed the lawful-use statement when the unit was registered, when,
  /// and which version of the words they saw.
  statementConfirmedAt   DateTime?
  statementConfirmedById String?
  statementVersion       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignments    TrackerAssignment[]
  locationEvents LocationEvent[]

  /// A real IMEI is also unique across all workspaces. GpsIndexesService makes
  /// that partial index, because adding it here would stop `db push`.
  @@unique([organisationId, serialNumber])
}

enum TrackerPowerSource {
  BATTERY
  HARD_WIRED
  OBD
}

enum LocationSource {
  GATEWAY
  MANUAL
}

model TrackerAssignment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackerId      String
  tracker        Tracker      @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  importJobId    String?
  importJob      ImportJob?   @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  assignedAt     DateTime     @default(now())
  removedAt      DateTime?
  /// True when the unit must be confirmed as taken out of the vehicle: a real
  /// unit that came off a job.
  removalRequired      Boolean   @default(false)
  removalConfirmedAt   DateTime?
  removalConfirmedById String?
  /// The fitter who took out a hard-wired or diagnostic-port unit.
  removalFitter        String?
  /// Set when staff were told the unit's battery was low, and cleared once it
  /// is charged again, so they are told once per drop.
  lowBatteryAlertedAt  DateTime?

  @@index([trackerId])
  @@index([vehicleId])
  @@index([importJobId])
  @@index([organisationId])
}

/// GPS points are independent of the current tracker assignment.
model LocationEvent {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackerId      String?
  tracker        Tracker?      @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  importJobId    String?
  importJob      ImportJob?    @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  latitude       Decimal       @db.Decimal(10, 7)
  longitude      Decimal       @db.Decimal(10, 7)
  accuracy       Decimal?      @db.Decimal(8, 2)
  speed          Decimal?      @db.Decimal(8, 2)
  heading        Decimal?      @db.Decimal(6, 2)
  recordedAt     DateTime
  receivedAt     DateTime      @default(now())
  /// Where the position came from: the GPS gateway, or typed in by staff.
  source         LocationSource @default(GATEWAY)
  /// A second copy of a tracker's ping, saved before pings were made unique.
  /// It is kept, left out of trails, and left out of the unique index.
  isDuplicate    Boolean       @default(false)

  /// GpsIndexesService also makes a partial unique index on
  /// (trackerId, recordedAt).
  @@index([importJobId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([organisationId, recordedAt])
  @@index([organisationId, importJobId])
}

model Document {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId     String
  importJob       ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  type            DocumentType @default(OTHER)
  name            String
  mimeType        String
  storageKey      String
  sizeBytes       Int
  uploadedById    String?
  uploadedBy      User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  customerVisible Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([importJobId])
  @@index([organisationId, importJobId])
}

model Photo {
  id              String        @id @default(cuid())
  organisationId  String
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId     String
  importJob       ImportJob     @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  category        PhotoCategory @default(OTHER)
  filename        String
  mimeType        String
  storageKey      String
  sizeBytes       Int
  uploadedById    String?
  uploadedBy      User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  customerVisible Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([importJobId])
  @@index([organisationId, importJobId])
}

model Task {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId    String
  importJob      ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assignedToId   String?
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notes          Note[]

  @@index([importJobId])
  @@index([organisationId, status, dueDate])
}

model Cost {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId      String
  importJob        ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  category         CostCategory
  description      String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("EUR")
  supplier         String?
  invoiceReference String?
  incurredOn       DateTime     @default(now())
  createdAt        DateTime     @default(now())

  @@index([importJobId])
  @@index([organisationId])
}

model CustomerCharge {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId    String
  importJob      ImportJob      @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  category       ChargeCategory
  description    String
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("EUR")
  incurredOn     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([importJobId])
  @@index([organisationId])
}

model Note {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importJobId    String?
  importJob      ImportJob?     @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId       String
  author         User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body           String
  visibility     NoteVisibility @default(INTERNAL)
  createdAt      DateTime       @default(now())

  @@index([importJobId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([taskId])
  @@index([organisationId])
}

model PortalInvite {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("PortalInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([customerId, createdAt])
  @@index([userId])
  @@index([organisationId])
}

/// Pending staff/admin/viewer invite. Token is hashed; raw value is only shown once.
model StaffInvite {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("StaffInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  role           UserRole
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organisationId])
}

/// One customer's erasure. It holds ids and counts, and no personal data. The
/// customer is named by id only. The same erasure is also written to a journal
/// outside the database, so it can be repeated after a restore.
model CustomerErasure {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customerId     String
  performedById  String
  performedAt    DateTime     @default(now())
  reappliedAt    DateTime?
  summary        Json

  reviewItems ErasureReviewItem[]

  @@unique([organisationId, customerId])
}

/// A record kept at an erasure because it is not clear that it may go.
model ErasureReviewItem {
  id          String          @id @default(cuid())
  erasureId   String
  erasure     CustomerErasure @relation(fields: [erasureId], references: [id], onDelete: Cascade)
  /// DOCUMENT, PHOTO, COST or CHARGE.
  kind        String
  recordId    String
  importJobId String?
  reason      String
  /// Empty until an Admin decides: KEPT or REMOVED.
  decision    String?
  decidedById String?
  decidedAt   DateTime?

  @@unique([erasureId, kind, recordId])
}

/// A workspace's acceptance of one version of one agreement, by one of its
/// Admins. The documents and their current versions live in @vip/shared.
model TermsAcceptance {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// TERMS_OF_SERVICE, DATA_PROCESSING_AGREEMENT or ACCEPTABLE_USE_POLICY.
  document        String
  version         String
  /// The sub-processor list shown at the time.
  subProcessorsVersion String
  acceptedById    String?
  acceptedBy      User?        @relation(fields: [acceptedById], references: [id], onDelete: SetNull)
  /// Kept as evidence of who accepted, even if the account is later removed.
  acceptedByName  String
  acceptedByEmail String
  acceptedAt      DateTime     @default(now())

  @@unique([organisationId, document, version])
  @@index([organisationId, acceptedAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
}
