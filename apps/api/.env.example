DATABASE_URL=postgresql://vip:vip@localhost:5432/vehicle_import?schema=public
# Signs sessions. Production refuses to start without a private value.
JWT_SECRET=replace-with-a-long-random-secret
# Encrypts two-factor secrets and backup codes. Production refuses to start without it.
# Generate with `openssl rand -base64 48`, keep it backed up, and do not change it:
# a new value makes saved two-factor setups unreadable. Left empty in development,
# JWT_SECRET is used. Values encrypted that way stay readable after this is set,
# as long as JWT_SECRET is unchanged.
TWO_FACTOR_ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d
PORT=3001
WEB_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Most file storage one organisation may use, in megabytes.
# STORAGE_ORG_QUOTA_MB=2048
ANPR_PROVIDER=mock
VEHICLE_DATA_PROVIDER=mock
# Real providers (optional). Mock stays the default for local demos.
# VEHICLE_DATA_PROVIDER=dvla
# DVLA_API_KEY=
# DVLA_VES_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
# ANPR_PROVIDER=platerecognizer
# PLATE_RECOGNIZER_API_KEY=
MAPS_PROVIDER=osm
# MAPBOX_TOKEN=

# Email: sign-up links, invites, password resets and customer updates. The default logs to the
# API console, where local sign-up links can be found. Production must set a provider:
# EMAIL_PROVIDER=brevo + BREVO_API_KEY, or resend + RESEND_API_KEY.
EMAIL_PROVIDER=log
EMAIL_FROM=Harbour <onboarding@resend.dev>
# RESEND_API_KEY=
# BREVO_API_KEY=
# Most emails Harbour sends in a day. Brevo's free 300 is shared with other products.
# EMAIL_DAILY_LIMIT=200

# How many proxies are in front of the API, for the client address that rate limits use.
# Defaults to 1 in production (the Caddy edge) and 0 elsewhere.
# TRUST_PROXY_HOPS=

# Harbour AI (staff-only). Default log / heuristics / templates — no network, never auto-posts or emails customers.
AI_PROVIDER=log
# Optional: AI_PROVIDER=openai + OPENAI_API_KEY for corridor suggest, Board triage, and note drafts.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Teltonika TAT140 via Flespi. Point the HTTP stream at POST /api/integrations/gps/flespi
# with header X-Harbour-Gps-Secret (or Authorization: Bearer …).
# FLESPI_WEBHOOK_SECRET=
# FLESPI_TOKEN=
# FLESPI_API_BASE=https://flespi.io

# Staff Board GPS ops alerts (tenant-scoped; never emailed to customers).
# Stale = assigned tracker on an active job with lastSeenAt older than this (ms). Default 2h.
# GPS_STALE_TRACKER_MS=7200000
# Near destination = last real ping within this radius (metres) of Limassol / route end
# while status is not yet ARRIVED_CYPRUS+. Default 5 km.
# GPS_NEAR_DESTINATION_METERS=5000
