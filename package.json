{
  "name": "vehicle-import-platform",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @vip/shared build && node scripts/dev.mjs",
    "dev:api": "pnpm --filter @vip/api dev",
    "dev:web": "pnpm --filter @vip/web dev",
    "build": "pnpm -r --filter @vip/shared --filter @vip/api --filter @vip/web run build",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @vip/api prisma:generate",
    "db:migrate": "pnpm --filter @vip/api prisma:migrate",
    "db:seed": "pnpm --filter @vip/api prisma:seed",
    "db:studio": "pnpm --filter @vip/api prisma:studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "prisma",
      "unrs-resolver"
    ]
  }
}
