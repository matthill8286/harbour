{
  "name": "vehicle-import-platform",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @vip/shared build && node scripts/dev.mjs",
    "dev:api": "pnpm --filter @vip/api dev",
    "dev:web": "pnpm --filter @vip/web dev",
    "build": "pnpm -r --filter @vip/shared --filter @vip/api --filter @vip/web run build",
    "lint": "pnpm -r run lint && pnpm format:check",
    "test": "pnpm --filter @vip/api test && pnpm --filter @vip/web test",
    "typecheck": "pnpm --filter @vip/shared build && pnpm --filter @vip/web exec tsc -p tsconfig.app.json --noEmit && pnpm --filter @vip/api exec tsc -p tsconfig.build.json --noEmit",
    "db:generate": "pnpm --filter @vip/api prisma:generate",
    "db:migrate": "pnpm --filter @vip/api prisma:migrate",
    "db:seed": "pnpm --filter @vip/api prisma:seed",
    "db:studio": "pnpm --filter @vip/api prisma:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "body-parser@^2": ">=2.4.0 <3",
      "proxy-addr@^2": ">=2.0.8 <3",
      "qs@^6": ">=6.16.1 <7"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
